<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/3.4/menu">
  <menu id="root-menu" label="Applications">
    <item label="Google Chrome">
      <action name="Execute">
        <command>google-chrome-stable</command>
      </action>
    </item>
    <separator />
    <item label="Terminal (xfce4)">
      <action name="Execute">
        <command>xfce4-terminal</command>
      </action>
    </item>
    <item label="File Manager (thunar)">
      <action name="Execute">
        <command>thunar</command>
      </action>
    </item>
    <item label="Text Editor (mousepad)">
      <action name="Execute">
        <command>mousepad</command>
      </action>
    </item>
    <separator />
    <item label="Reconfigure Openbox">
      <action name="Reconfigure" />
    </item>
    <item label="Restart Window Manager">
      <action name="Restart" />
    </item>
  </menu>
</openbox_menu>
