# Virtual Machine Authentication Password
# Change this to whatever password you want to unlock the desktop session
VM_PASSWORD=ChangeThisPassword123!

# Display Configuration
VM_RESOLUTION=1280x720
DISPLAY_NUM=:1

# Initial URL to open on browser launch
START_URL=https://www.google.com

# Gateway Listening Ports (comma separated)
VM_PORTS=3000,6080,8080
AUDIO_PORT=6081
